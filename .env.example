APP_NAME=DoorIQ Chatbot API
APP_ENV=development
APP_DEBUG=true
# Local testing/dev without Docker:
DATABASE_URL=sqlite:///./dooriq_local.db
# Production / Docker PostgreSQL:
# DATABASE_URL=postgresql+psycopg://dooriq:dooriq_password@localhost:5433/dooriq
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
LOCAL_EMBEDDING_DIMENSIONS=128
